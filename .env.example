# Kronos Trading System - Environment Variables
# SECURITY WARNING: NEVER commit this file with real keys to Git!
# Copy this to .env and fill your own keys: cp .env.example .env
# Then add .env to .gitignore (already included)

# === Binance API (Get from https://testnet.binance.vision for paper trading) ===
# For $100 account, use TESTNET first!
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_SECRET_KEY=your_testnet_secret_here
BINANCE_TESTNET=true

# For LIVE trading (only after profitable paper trading!):
# BINANCE_API_KEY=your_live_api_key
# BINANCE_SECRET_KEY=your_live_secret
# BINANCE_TESTNET=false

# === Telegram Alerts (Optional) ===
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === Discord Webhook (Optional) ===
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook_here

# === HuggingFace Token (Optional, for faster downloads) ===
# Get from https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# === System ===
PYTHONPATH=.
