# Kronos Trading System - Gitignore (Security First)

# === Secrets (CRITICAL) ===
.env
*.key
*.secret
credentials.json
api_keys.txt
*_api_key*
.env.local
.env.production

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.env/
*.egg-info/
dist/
build/
*.egg

# === Kronos Model Cache (large files) ===
models/*.bin
models/*.safetensors
models/kronos-*
models/tokenizer/
models/model/
# Keep selected_model.yaml
!models/selected_model.yaml

# === Data (may contain sensitive P&L) ===
data/raw/*
data/processed/*
data/db/*.db
data/db/*.sqlite
data/db/*.json
data/eval/*
data/derivatives/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/db/.gitkeep

# Keep structure but ignore contents
!data/**/*.md

# === Logs ===
logs/*
!logs/.gitkeep
*.log

# === Jupyter ===
.ipynb_checkpoints/
*.ipynb
notebooks/*

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Trading Specific ===
paper_trades.json
live_trades.json
performance_report.html
equity_curve.png
backtest_results/
live_positions.json

# === Freqtrade HAR research (freqtrade_har/) ===
# Mirror of freqtrade_har/.gitignore_freqtrade
# (git only honors ignore files named exactly ".gitignore")
freqtrade_har/user_data/data/
freqtrade_har/user_data/backtest_results/
freqtrade_har/user_data/logs/
freqtrade_har/user_data/tradesv3.dryrun.sqlite
*.dryrun.sqlite
!freqtrade_har/user_data/.gitkeep

# === Node (for dashboard) ===
node_modules/
.streamlit/
backtest_results/
live_positions.json
# === Generated QuantStats reports (uploaded as Actions artifacts) ===
reports/*.html
reports/*.csv

# === Phase 9A / paper execution runtime artifacts (local SQLite, not Supabase) ===
execution/*.db
execution/*.db-wal
execution/*.db-shm
